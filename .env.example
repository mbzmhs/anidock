# 字幕组 RSS 番剧聚合站 · 环境变量模板（复制为 backend/.env 后填写）
# 所有变量均可在后台「⚙ 设置」中被 DB 覆盖并热生效；.env 只作为初始/回落值。

# Bangumi（快照/归档辅助导入用；只调用只读接口，不依赖实时数据）
BANGUMI_BASE_URL=https://api.bgm.tv
BANGUMI_TOKEN=

# 存储
DB_PATH=./data/db.sqlite
MEDIA_DIR=./media
MIRROR_DIR=./data/mirror
# 单文件镜像大小上限：字节数或 512MiB / 4GiB 写法（默认 4GiB）
MIRROR_MAX_SIZE=4GiB

# 服务
PORT=8080
# RSS 轮询间隔（Go duration）
FETCH_INTERVAL=3m
# 前端编译产物目录（空则不托管，开发期用 Vite :5173）
FRONTEND_DIST=../frontend/dist

# 归档自动下载（后台「归档批量导入 → 自动下载最新归档」）
# 默认从 GitHub 抓取 bangumi/Archive 的 latest.json；
# 网络受限时可指向自托管的 latest.json（格式与 GitHub 的一致，浏览器下载地址改为可访问的 URL）
ARCHIVE_LATEST_JSON=

# 口令（首次登录后台后可在「设置」里改，DB 值优先）
ADMIN_PASSWORD=
# 访客口令：留空 = 站点公开；填写后前台访问需输口令（/gate）
VISITOR_PASSWORD=
