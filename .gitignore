backend/media/
frontend/data/
frontend/media/

# 构建产物与依赖
frontend/node_modules/
frontend/dist/

# 日志与临时文件
*.log
/tmp/

# Python 缓存
__pycache__/
*.pyc

# 本地设计文档（不进开源仓库）
DESIGN.md
